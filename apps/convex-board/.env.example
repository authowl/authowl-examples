# Copy to `.env.local` (gitignored) before linking Convex. Fill the two
# AuthOwl values; Convex CLI writes its own values into the same file.
#
# ⚠️ This example needs Configure -> JWT templates set up in AuthOwl:
#    enable the environment issuer and create the `convex` preset/template.
#    That publishes the JWKS and lets the client mint the named token Convex
#    verifies.

VITE_AUTHOWL_PUBLISHABLE_KEY=
VITE_AUTHOWL_API_URL=

# Written by `npx convex dev --once` when it links a deployment. Replace any
# placeholder - leaving one here makes the board connect to the wrong backend.
VITE_CONVEX_URL=

# ---------------------------------------------------------------------------
# Convex reads its own env from the DEPLOYMENT, not from this file. Set those
# two once, from your project's public-config `jwtIssuer` block:
#
#   npx convex env set AUTHOWL_ISSUER_URL <jwtIssuer.issuer>
#   npx convex env set AUTHOWL_PROJECT_ID <jwtIssuer.aud>
# ---------------------------------------------------------------------------
