# Copy to `.env.local` (gitignored) and fill from your AuthOwl dashboard.
#
# The project must have Organizations / teams switched ON under
# Settings -> Auth methods, and http://localhost:5175 on its allowed origins.
VITE_AUTHOWL_PUBLISHABLE_KEY=
# The AuthOwl API origin. Use https://authowl.dev unless you are self-hosting.
VITE_AUTHOWL_API_URL=https://authowl.dev
